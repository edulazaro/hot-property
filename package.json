{
  "name": "hot-property",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:itch": "vite --mode itch",
    "build": "tsc && vite build",
    "build:itch": "tsc && vite build --mode itch --outDir dist-itch && rm -f hot-property-itch.zip && cd dist-itch && zip -qr ../hot-property-itch.zip .",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "tsc && biome check . && vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
